# Gemini menu generation through Google's OpenAI-compatible endpoint.
# GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.1-flash-lite

# Image generation for dish reveals.
# Create .env.local and add your real key there; never commit it.
# RUNWARE_API_KEY=

# Public-user authentication. Create a Supabase project, enable Google OAuth,
# and add this site's /auth/callback URL to the redirect allowlist.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your_publishable_key
AUTH_PROVIDERS=google

# Comma-separated verified emails that can manage quota overrides.
# ADMIN_EMAILS=you@example.com

# Generate with: openssl rand -base64 32
# DISH_TOKEN_SECRET=

# Server-enforced daily quotas. Trusted/admin users skip per-user limits only.
MENU_DAILY_LIMIT=10
IMAGE_DAILY_LIMIT=5
GLOBAL_MENU_DAILY_LIMIT=100
GLOBAL_IMAGE_DAILY_LIMIT=100
